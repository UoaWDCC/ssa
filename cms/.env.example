DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Stripe — copy keys from Stripe Dashboard > Developers
STRIPE_SECRET_KEY=sk....
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price...

# URL of the public web app (used for Stripe success/cancel redirects)
WEB_URL=http://localhost:3000

# Shared secret for internal web→CMS calls (must match GOOGLE_OAUTH_COOKIE_SECRET in the web app)
GOOGLE_OAUTH_COOKIE_SECRET=YOUR_GOOGLE_OAUTH_COOKIE_SECRET_HERE

# Secret used to temporarily encrypt signup passwords until Stripe confirms payment
SIGNUP_ENCRYPTION_KEY=YOUR_SIGNUP_ENCRYPTION_KEY_HERE
